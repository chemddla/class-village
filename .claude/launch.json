{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "village",
      "url": "http://localhost:5173",
      "port": 5173
    },
    {
      "name": "village-main",
      "url": "http://localhost:5180",
      "port": 5180
    },
    {
      "name": "village-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "village-sketch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "client", "--port", "5199"],
      "port": 5199
    },
    {
      "name": "village-own",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "concurrently",
        "node server/index.js",
        "vite client --host --port 5191 --strictPort"
      ],
      "env": {
        "GAME_PORT": "2591",
        "VITE_GAME_PORT": "2591"
      },
      "port": 5191
    }
  ]
}